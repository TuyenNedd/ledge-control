<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copied verbatim into dist/Ledge.app/Contents/Info.plist by `make app`.

  CFBundleIdentifier is fixed and must stay that way: a bare binary has no bundle identity at
  all, and a generated identifier would give the app a different one on every build, so
  Accessibility permission could never be held for longer than one launch.

  A fixed identifier is necessary but NOT sufficient for the grant to survive a rebuild. TCC
  matches on the designated requirement, which for the ad-hoc signature `make app` applies is
  derived from the code directory hash and therefore changes with every build. The visible symptom
  is the app appearing enabled in Privacy & Security > Accessibility while the grant has no
  effect and CGEvent.tapCreate still returns nil. `make reset-permission` clears it; a stable
  self-signed certificate avoids it. See the header comment in the Makefile.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Ledge</string>
	<key>CFBundleExecutable</key>
	<string>Ledge</string>
	<key>CFBundleIdentifier</key>
	<string>xyz.tuyennedd.ledge</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ledge</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- A menu bar app: no Dock icon, no app menu. main.swift sets the matching activation
	     policy so that `swift run` behaves the same way without a bundle. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Tuyen Nguyen. MIT licensed.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Sparkle auto-update configuration -->
	<key>SUFeedURL</key>
	<string>https://tuyennedd.github.io/ledge-control/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string></string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
</dict>
</plist>
